{
  "name": "dsh-background-studio",
  "version": "1.1.2",
  "description": "Replace the DeepSeek Harness solid background with your own image, with an in-app editor for fit, blur, veil and interface opacity.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "PUBLISHING.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "background",
    "wallpaper",
    "image"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wenhaolin-svg/dsh-background.git"
  },
  "homepage": "https://github.com/wenhaolin-svg/dsh-background#readme",
  "bugs": {
    "url": "https://github.com/wenhaolin-svg/dsh-background/issues"
  },
  "icon": "./icon.svg",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node test/host.test.mjs && node test/client.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
